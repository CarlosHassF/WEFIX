generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model fichas {
  id_manutencao  BigInt   @id @default(autoincrement())
  nome_cliente   String?  @db.VarChar(50)
  valor_servico  Decimal? @default(50.0) @db.Decimal(10, 2)
  numero_cliente String?  @db.VarChar(16)
  observacao     String?  @db.VarChar(400)
  status         tipos    @default(novo)
}

model usuarios {
  id_usuario    BigInt @id @default(autoincrement())
  nome_usuario  String @db.VarChar(100)
  email_usuario String @unique @db.VarChar(100)
  senha_usuario String @db.VarChar(255)
  cargo_usuario cargos
}

enum tipos {
  novo
  em_manuten__o @map("em manutenção")
  entregue
  cancelado
  concertado
}

enum cargos {
  atendente
  admin
  tecnico
}
