# variaveis de database
DATABASE_URL=<dburl>
# banco separado usado pelos testes (pnpm test:db recria, pnpm test usa)
TEST_DATABASE_URL=<dburl de teste>

# variaveis de segurança e session management
JWT_SECRET=<token do jwt>

# integracao n8n
N8N_API_KEY=<chave que o n8n envia no header x-api-key>
N8N_WEBHOOK_URL=<url do webhook do n8n>

# admin inicial criado pelo seed
ADMIN_EMAIL=<email do admin>
ADMIN_SENHA=<senha do admin>
