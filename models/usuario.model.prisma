// DECISAO: tamanhos de VarChar — escolhido: nome 100, email 100, hash 255; alternativas: outros limites
// funcionarios da assistencia; nunca apagados, so desativados
model Usuario {
  id_usuario    BigInt  @id @default(autoincrement())
  nome_usuario  String  @db.VarChar(100)
  email_usuario String  @unique @db.VarChar(100)
  senha_usuario String  @db.VarChar(255)
  cargo_usuario Cargos
  ativo         Boolean @default(true)

  fichas_abertas   Ficha[]  @relation("FichaAtendente")
  fichas_assumidas Ficha[]  @relation("FichaTecnico")
  eventos          Evento[]

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

// tipos de cargos que um usuario pode possuir
enum Cargos {
  atendente
  admin
  tecnico
}
