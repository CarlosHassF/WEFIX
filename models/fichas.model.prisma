// fichas que os usuarios produzem
model Fichas {
  id_manutencao  BigInt   @id @default(autoincrement())
  nome_cliente   String?  @db.VarChar(50)
  valor_servico  Decimal? @default(50.0) @db.Decimal(10, 2)
  numero_cliente String?  @db.VarChar(16)
  observacao     String?  @db.VarChar(400)
  status         Tipos    @default(novo)
}

// tipos de status que uma ficha pode assumir
enum Tipos {
  novo
  em_manutencao
  entregue
  cancelado
  concertado
}